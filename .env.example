# Resumestan environment variables
# Copy to .env and fill values. Do not commit .env.

# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
BCRYPT_SALT_ROUNDS=10

# Canva OAuth (from Canva Developer Portal)
CANVA_CLIENT_ID=""
CANVA_CLIENT_SECRET=""
# Must match a Redirect URL registered in Canva app config
# Local: http://127.0.0.1:3000/api/canva/callback
# Prod:  https://resumestan.vercel.app/api/canva/callback
CANVA_REDIRECT_URI="http://127.0.0.1:3000/api/canva/callback"

# Google Gemini
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-3-flash-preview"

# Email (SMTP/Hostinger mailbox for OTP verification)
EMAIL_USER=""
EMAIL_PASS=""

# Public app URL (used for redirects/fallbacks)
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"
